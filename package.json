{
  "name": "pomodoro",
  "version": "1.0.0",
  "description": "A dark-themed Pomodoro timer desktop app",
  "main": "dist/main/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "esbuild src/renderer/index.ts --bundle --outfile=dist/renderer/bundle.js --platform=browser",
    "copy:assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/renderer/styles',{recursive:true});['src/renderer/index.html','src/renderer/styles/variables.css','src/renderer/styles/base.css','src/renderer/styles/components.css'].forEach(f=>fs.copyFileSync(f,f.replace('src/renderer','dist/renderer')))\"",
    "build": "npm run build:main && npm run build:renderer && npm run copy:assets",
    "dev": "npm run build && electron ."
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  }
}
